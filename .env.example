# 両アプリ共通（apps/admin/.env.local, apps/delivery/.env.local にコピーする）
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 移行スクリプト用（service_role キーはサーバー側でのみ使う。絶対にアプリへ入れない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Amazon values belong ONLY in Supabase Edge Function Secrets (never VITE_*).
# Required secret names: AMAZON_LWA_CLIENT_ID, AMAZON_LWA_CLIENT_SECRET,
# AMAZON_LWA_REFRESH_TOKEN, AMAZON_SELLER_ID. Do not put their values in this file.
