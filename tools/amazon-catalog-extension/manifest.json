{
  "manifest_version": 3,
  "name": "Amazon 商品リスト登録",
  "version": "0.1.16",
  "description": "Amazon.co.jpの商品を管理アプリで確認・登録し、Keepaの売れ行きと相場を表示します。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://bussan-admin.vercel.app/*",
    "https://test-repo-delivery.vercel.app/*",
    "https://bussan-delivery.vercel.app/*",
    "https://xgoppuqoqeppckyunnvx.supabase.co/*",
    "https://api.keepa.com/*",
    "https://www.amazon.co.jp/*",
    "https://amazon.co.jp/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/*",
        "https://amazon.co.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
