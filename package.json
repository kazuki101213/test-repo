{
  "name": "bussan-kanri",
  "private": true,
  "version": "0.1.0",
  "description": "Amazon/メルカリ物販の在庫・納品・古物台帳管理システム",
  "scripts": {
    "dev:admin": "pnpm --filter @bussan/admin dev",
    "dev:delivery": "pnpm --filter @bussan/delivery dev",
