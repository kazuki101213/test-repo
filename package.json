    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "import": "node scripts/import-sheets.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  }
}